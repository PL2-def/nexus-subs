# Port du serveur en production (par défaut 3001, ou 3000)
PORT=3000
PUBLIC_URL=http://localhost:3000

# Mot de passe Admin initial (modifiable depuis l'interface Admin > Paramètres)
ADMIN_PASSWORD=admin

# Stripe Checkout (configurables aussi directement dans l'interface Admin !)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal REST API v2 ou PayPal.Me (configurables aussi dans l'interface Admin !)
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ME_URL=

# Email SMTP optionnel (ex: Mot de passe d'application Gmail 16 caractères)
SMTP_PASS=
